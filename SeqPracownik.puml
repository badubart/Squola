@startuml
autonumber

actor "Administrator" as Admin
    participant "Panel Administratora" as UI
    participant "ReservationService" as BookingSvc
    participant "RoomService" as RoomSvc
    participant "ScheduleService" as ScheduleSvc
    participant "LessonService" as LessonSvc
    participant "NotificationService" as NotifSvc
database "Baza Danych" as DB

== Podgląd dostępności i przypisywanie sal ==
Admin -> UI : Wybór zakładki "Dostępność sal"
UI -> RoomSvc : getRoomAvailability(date, timeRange)
RoomSvc -> DB : Pobierz aktualny stan i rezerwacje sal
DB --> RoomSvc : Lista sal wraz z przypisanymi lekcjami
RoomSvc --> UI : Dane siatki zajętości sal
UI --> Admin : Wyświetlenie dostępności sal

Admin -> UI : Przypisanie konkretnej sali do lekcji
UI -> RoomSvc : assignRoomToLesson(lessonId, roomId)
RoomSvc -> DB : Aktualizuj obiekt Lesson
DB --> RoomSvc : Potwierdzenie zapisu w bazie
RoomSvc --> UI : Sukces operacji
UI --> Admin : Komunikat: "Sala została pomyślnie przypisana do zajęć"

== Zarządzanie zastępstwami nauczycieli i modyfikacja zajęć ==
Admin -> UI : Wybór zajęć wymagających zmiany prowadzącego (np. nagła absencja)
UI -> ScheduleSvc : getAvailableTeachersForSlot(datetime, subject)
ScheduleSvc -> DB : Pobierz nauczycieli z wolnym statusem i pasującym przedmiotem
DB --> ScheduleSvc : Lista dostępnych kadrowiczów
ScheduleSvc --> UI : Lista sugerowanych zastępców
UI --> Admin : Wyświetlenie dostępnych nauczycieli spełniających kryteria

Admin -> UI : Wybór nowego nauczyciela i kliknięcie "Zatwierdź zastępstwo"
UI -> ScheduleSvc : applyTeacherSubstitution(lessonId, newTeacherId)
ScheduleSvc -> DB : Aktualizuj obiekt Lesson (zmień teacherId)
DB --> ScheduleSvc : Zapisano zmianę w bazie danych

== Automatyczne Powiadomienia ==
ScheduleSvc -> NotifSvc : triggerSubstitutionNotifications(lessonId)
NotifSvc -> DB : Pobierz kontakty (Uczeń, stary Nauczyciel, nowy Nauczyciel)
DB --> NotifSvc : Dane kontaktowe (E-mail / Telefon)
NotifSvc --> UI : Powiadomienia systemowe wysłane
ScheduleSvc --> UI : Potwierdzenie modyfikacji
UI --> Admin : Komunikat: "Zastępstwo wprowadzone. Wysłano powiadomienia do uczestników."

== Ręczne Anulowanie Zajęć przez Administratora ==
Admin -> UI : Wybór zajęć z głównego harmonogramu -> Kliknięcie "Anuluj zajęcia"
UI -> ScheduleSvc : cancelLessonByAdmin(lessonId, reason)
ScheduleSvc -> DB : Zmień status lekcji/rezerwacji na "Anulowane"
DB --> ScheduleSvc : Zaktualizowano pomyślnie
ScheduleSvc -> NotifSvc : sendCancellationNotice(lessonId, reason)
NotifSvc --> UI : Wysłanie wiadomości SMS/E-mail o odwołaniu lekcji
ScheduleSvc --> UI : Sukces anulowania
UI --> Admin : Odświeżenie widoku

== Monitoring dostępności nauczycieli ==
Admin -> UI : Przejście do sekcji "Dostępność nauczycieli"
UI -> ScheduleSvc : getTeacherAvailability()
ScheduleSvc -> DB : Pobierz grafik nauczycieli
DB --> ScheduleSvc : Lista nauczycieli i ich dostępnościach
ScheduleSvc --> UI : Dane dostępności
UI --> Admin : Wyświetlenie matrycy dostępności


== Generowanie raportów i analityki ==
Admin -> UI : Kliknięcie "Generuj raport"
UI -> LessonSvc : generateLessonReport(dateRange, filters)
LessonSvc -> DB : Pobierz statystyki lekcji
DB --> LessonSvc : Dane raportowe
LessonSvc --> UI : Raport wygenerowany
UI --> Admin : Wyświetlenie i możliwość eksportu raportu

@enduml